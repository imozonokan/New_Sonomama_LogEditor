<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ココフォリア新形式・そのままログ整形えでぃたー</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- SortableJS CDN (ドラッグ＆ドロップ用) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.0/Sortable.min.js"></script>
  <style>
    .drag-handle { cursor: grab; }
    .drag-handle:active { cursor: grabbing; }
    .sortable-ghost { opacity: 0.4; background-color: #f3f4f6; border: 2px dashed #9ca3af; }
    .color-swatch { width: 24px; height: 24px; border-radius: 4px; border: 1px solid rgba(0,0,0,0.2); transition: transform 0.1s ease; }
    .color-swatch:hover { transform: scale(1.15); }
  </style>
  <style id="preview-styles">
    /* 読み込み時にアバター画像のみのCSSがここに注入されます */
  </style>
</head>
<body class="bg-gray-50 text-gray-800 h-screen flex flex-col overflow-hidden">

  <!-- ヘッダー -->
  <header class="bg-indigo-900 text-white p-4 shadow-md flex justify-between items-center shrink-0">
    <h1 class="text-xl font-bold">ココフォリア新形式・そのままログ整形えでぃたー</h1>
    <div class="flex items-center space-x-3">
      <label class="bg-indigo-700 hover:bg-indigo-600 px-4 py-2 rounded cursor-pointer transition text-sm">
        新形式のログファイルを読み込む
        <input type="file" id="fileInput" accept=".html" class="hidden" />
      </label>
      <button id="exportBtn" class="bg-green-600 hover:bg-green-500 px-4 py-2 rounded text-sm font-semibold transition hidden">
        HTMLログを出力して保存
      </button>
    </div>
  </header>

  <!-- メインコンテンツ -->
  <main class="flex-1 flex overflow-hidden">
    <!-- サイドバー -->
    <aside id="sidebar" class="bg-white border-r border-gray-200 p-4 flex flex-col justify-between overflow-y-auto hidden shrink-0" style="width: 22rem;">
      <div class="space-y-5">
        <div>
          <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">タブ表示/出力切り替え</h2>
          <div id="tabFilters" class="space-y-2"></div>
        </div>

        <div class="space-y-3">
          <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">一括処理・成形ツール</h2>
          
          <div class="bg-red-50 border border-red-200 p-2.5 rounded-md">
            <label class="flex items-center justify-between cursor-pointer">
              <span class="text-xs font-bold text-red-800">集中削除モード</span>
              <input type="checkbox" id="fastDeleteToggle" class="sr-only peer">
              <div class="relative w-9 h-5 bg-gray-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-red-600"></div>
            </label>
          </div>

          <div class="bg-gray-50 p-2.5 rounded border border-gray-200 space-y-2">
            <div class="flex justify-between items-center text-xs text-gray-600 font-semibold">
              <span>選択中の発言:</span>
              <span id="selectedCountLabel" class="text-indigo-600 font-bold">0 件</span>
            </div>
            <div class="flex space-x-1.5">
              <button id="selectAllBtn" class="w-1/2 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs py-1.5 rounded font-semibold transition">表示中を全選択</button>
              <button id="deselectAllBtn" class="w-1/2 bg-gray-200 hover:bg-gray-300 text-gray-700 text-xs py-1.5 rounded font-semibold transition">選択解除</button>
            </div>
            <button id="deleteSelectedBtn" class="w-full bg-red-600 hover:bg-red-500 disabled:bg-gray-300 text-white text-xs py-1.5 rounded font-semibold transition shadow-sm" disabled>
              選択した発言を一括削除
            </button>
          </div>

          <button id="simplifyDiceBtn" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white text-xs py-2 rounded font-semibold transition shadow-sm flex items-center justify-center space-x-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
            <span>ダイス成否判定を一括簡略化</span>
          </button>

          <button id="removeSlashBtn" class="w-full bg-amber-600 hover:bg-amber-500 text-white text-xs py-2 rounded font-semibold transition shadow-sm">
            文末・セリフ直後の「/」を一括削除
          </button>

          <details class="bg-gray-50 border border-gray-200 rounded p-2 text-xs">
            <summary class="font-bold text-gray-700 cursor-pointer select-none">文字列の一括置換・一括削除</summary>
            <div class="mt-2 space-y-2 pt-1 border-t border-gray-200">
              <input type="text" id="replaceSearchInput" class="w-full border border-gray-300 rounded px-2 py-1 text-xs bg-white text-gray-800" placeholder="検索する文字列" />
              <input type="text" id="replaceWithInput" class="w-full border border-gray-300 rounded px-2 py-1 text-xs bg-white text-gray-800 mt-1" placeholder="置換後の文字列 (空欄で削除)" />
              <button id="executeReplaceBtn" class="w-full bg-teal-600 hover:bg-teal-500 text-white text-xs py-1.5 rounded font-semibold transition shadow-sm mt-2">一括置換 / 削除</button>
            </div>
          </details>

          <details class="bg-gray-50 border border-red-200 rounded p-2 text-xs">
            <summary class="font-bold text-red-800 cursor-pointer select-none">発言の条件一括削除 (保護機能付)</summary>
            <div class="mt-2 space-y-2 pt-1 border-t border-red-100">
              <input type="text" id="filterDeleteInput" class="w-full border border-gray-300 rounded px-2 py-1 text-xs bg-white text-gray-800" placeholder="削除対象にする文字列" />
              <input type="text" id="filterProtectInput" class="w-full border border-gray-300 rounded px-2 py-1 text-xs bg-white text-gray-800 mt-1" placeholder="保護する文字列" />
              <button id="executeFilterDeleteBtn" class="w-full bg-red-600 hover:bg-red-500 text-white text-xs py-1.5 rounded font-semibold transition shadow-sm mt-2">条件一致を一括削除</button>
            </div>
          </details>
        </div>

        <div>
          <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">キャラクター一覧と操作</h2>
          <div id="charList" class="space-y-3 max-h-40 overflow-y-auto pr-1 border border-gray-100 p-2 rounded"></div>
        </div>

        <div class="border-t border-gray-200 pt-4">
          <h2 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">新規発言の追加</h2>
          
          <div id="insertIndicator" class="hidden bg-blue-50 border border-blue-200 rounded p-2 mb-3 text-xs flex justify-between items-center text-blue-800">
            <div><span class="font-bold">挿入位置:</span> <span id="insertTargetLabel"></span> の後ろ</div>
            <button id="cancelInsertBtn" class="text-red-500 hover:text-red-700 font-bold hover:underline">キャンセル</button>
          </div>

          <div class="space-y-2">
            <input type="text" id="addName" class="w-full border border-gray-300 rounded px-2 py-1 text-sm bg-white text-gray-800" placeholder="発言者名 (空欄でシステムログ)" />
            <div class="flex space-x-2">
              <select id="addTab" class="w-1/2 border border-gray-300 rounded px-2 py-1 text-sm bg-white text-gray-800">
                <!-- 動的に生成 -->
              </select>
              <input type="text" id="addTextColor" class="w-1/2 border border-gray-300 rounded px-2 py-1 text-sm font-mono bg-white text-gray-800" value="#888888" placeholder="#888888" />
            </div>
            <div id="addPaletteGrid" class="grid grid-cols-8 gap-1 p-1 bg-gray-50 rounded border border-gray-200"></div>
            <textarea id="addContent" rows="3" class="w-full border border-gray-300 rounded px-2 py-1 text-sm bg-white text-gray-800" placeholder="発言内容を入力"></textarea>
            <button id="addLogBtn" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white text-xs py-2 rounded font-semibold transition">末尾に追加</button>
          </div>
        </div>
      </div>
    </aside>

    <!-- エディターメイン画面 -->
    <section class="flex-1 flex flex-col bg-white overflow-hidden relative">
      <div id="welcomeScreen" class="flex-1 flex flex-col justify-center items-center p-8 text-center bg-gray-100">
        <svg class="w-16 h-16 text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        <p class="text-lg font-semibold text-gray-600">ココフォリアから出力したHTMLログ(新形式)を選択するか、ここにドラッグ＆ドロップしてください。</p>
      </div>

      <div id="editorContainer" class="flex-1 overflow-y-auto p-4 space-y-2 hidden bg-gray-100">
        <div id="logList" class="space-y-2"></div>
      </div>
    </section>
  </main>

  <div id="colorModal" class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center hidden">
    <div class="bg-white rounded-lg shadow-xl p-6 w-80">
      <h3 class="font-bold text-lg mb-2 text-gray-800">カラーの一括変更</h3>
      <p class="text-sm text-gray-500 mb-3">発言者: <span id="modalTargetChar" class="font-semibold text-indigo-600"></span></p>
      <div class="mb-4"><div id="modalPaletteGrid" class="grid grid-cols-6 gap-1.5 p-2 bg-gray-50 rounded border"></div></div>
      <div class="mb-5"><input type="text" id="modalColorText" class="border border-gray-300 rounded px-3 py-2 w-full text-sm font-mono bg-white text-gray-800" placeholder="#888888" /></div>
      <div class="flex justify-end space-x-2">
        <button id="modalCancelBtn" class="px-4 py-2 text-sm text-gray-600 hover:bg-gray-100 rounded transition">キャンセル</button>
        <button id="modalConfirmBtn" class="px-4 py-2 text-sm bg-indigo-600 text-white hover:bg-indigo-500 rounded font-semibold transition">適用</button>
      </div>
    </div>
  </div>

  <script>
    const presetColors = [
      '#000000', '#4b5563', '#888888', '#d1d5db', '#ffffff',
      '#ef4444', '#f87171', '#fca5a5', '#f97316', '#fb923c',
      '#eab308', '#facc15', '#22c55e', '#4ade80', '#10b981',
      '#06b6d4', '#2563eb', '#3b82f6', '#60a5fa', '#6366f1',
      '#818cf8', '#a855f7', '#c084fc', '#ec4899'
    ];

    let logs = []; 
    let activeTabs = new Set(); 
    let tabNamesMap = new Map(); // 内部IDと表示名(日本語)の紐付け用
    let currentEditIndex = null;
    let insertTargetIndex = null; 
    let loadedFileName = ''; 
    let fastDeleteMode = false; 
    let globalStyles = "";
    let documentTitle = "ccfolia - logs";

    const fileInput = document.getElementById('fileInput');
    const exportBtn = document.getElementById('exportBtn');
    const welcomeScreen = document.getElementById('welcomeScreen');
    const sidebar = document.getElementById('sidebar');
    const editorContainer = document.getElementById('editorContainer');
    const logList = document.getElementById('logList');
    const tabFilters = document.getElementById('tabFilters');
    const charList = document.getElementById('charList');

    const fastDeleteToggle = document.getElementById('fastDeleteToggle');
    const selectAllBtn = document.getElementById('selectAllBtn');
    const deselectAllBtn = document.getElementById('deselectAllBtn');
    const deleteSelectedBtn = document.getElementById('deleteSelectedBtn');
    const selectedCountLabel = document.getElementById('selectedCountLabel');

    const simplifyDiceBtn = document.getElementById('simplifyDiceBtn');
    const replaceSearchInput = document.getElementById('replaceSearchInput');
    const replaceWithInput = document.getElementById('replaceWithInput');
    const executeReplaceBtn = document.getElementById('executeReplaceBtn');
    const filterDeleteInput = document.getElementById('filterDeleteInput');
    const filterProtectInput = document.getElementById('filterProtectInput');
    const executeFilterDeleteBtn = document.getElementById('executeFilterDeleteBtn');

    const addTextColor = document.getElementById('addTextColor');
    const addPaletteGrid = document.getElementById('addPaletteGrid');
    const addLogBtn = document.getElementById('addLogBtn');
    const insertIndicator = document.getElementById('insertIndicator');
    const insertTargetLabel = document.getElementById('insertTargetLabel');
    const cancelInsertBtn = document.getElementById('cancelInsertBtn');

    const colorModal = document.getElementById('colorModal');
    const modalTargetChar = document.getElementById('modalTargetChar');
    const modalPaletteGrid = document.getElementById('modalPaletteGrid');
    const modalColorText = document.getElementById('modalColorText');
    const modalCancelBtn = document.getElementById('modalCancelBtn');
    const modalConfirmBtn = document.getElementById('modalConfirmBtn');
    let activeColorTargetName = '';

    function rgbToHex(colorStr) {
      if (!colorStr) return '#888888';
      const trimmed = colorStr.trim();
      if (trimmed.startsWith('#')) return trimmed;
      const match = trimmed.match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*[\d.]+)?\)$/i);
      if (match) {
        const r = parseInt(match[1], 10).toString(16).padStart(2, '0');
        const g = parseInt(match[2], 10).toString(16).padStart(2, '0');
        const b = parseInt(match[3], 10).toString(16).padStart(2, '0');
        return `#${r}${g}${b}`.toLowerCase();
      }
      return trimmed;
    }

    function initPaletteGrids() {
      presetColors.forEach(color => {
        let btn = document.createElement('button');
        btn.type = 'button'; btn.className = 'color-swatch'; btn.style.backgroundColor = color; btn.title = color;
        btn.onclick = () => addTextColor.value = color;
        addPaletteGrid.appendChild(btn);

        let mBtn = document.createElement('button');
        mBtn.type = 'button'; mBtn.className = 'color-swatch w-full h-7 rounded border border-black/10'; mBtn.style.backgroundColor = color; mBtn.title = color;
        mBtn.onclick = () => modalColorText.value = color;
        modalPaletteGrid.appendChild(mBtn);
      });
    }
    initPaletteGrids();

    fastDeleteToggle.addEventListener('change', (e) => {
      fastDeleteMode = e.target.checked;
      renderLogs();
    });

    new Sortable(logList, {
      handle: '.drag-handle',
      animation: 150,
      ghostClass: 'sortable-ghost',
      onEnd: function () {
        const newLogs = [];
        logList.querySelectorAll('[data-index]').forEach((el) => {
          newLogs.push(logs[parseInt(el.dataset.index, 10)]);
        });
        logs = newLogs;
        cancelInsertMode();
        renderLogs(); 
      }
    });

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      loadedFileName = file.name;
      const reader = new FileReader();
      reader.onload = (evt) => parseAndLoadHTML(evt.target.result);
      reader.readAsText(file);
    });

    document.addEventListener('dragover', (e) => e.preventDefault());
    document.addEventListener('drop', (e) => {
      e.preventDefault();
      if (e.dataTransfer.files.length > 0) {
        const file = e.dataTransfer.files[0];
        if (file.name.endsWith('.html')) {
          loadedFileName = file.name;
          const reader = new FileReader();
          reader.onload = (evt) => parseAndLoadHTML(evt.target.result);
          reader.readAsText(file);
        }
      }
    });

    function parseAndLoadHTML(htmlText) {
      const parser = new DOMParser();
      const doc = parser.parseFromString(htmlText, 'text/html');
      
      const titleEl = doc.querySelector('title');
      if (titleEl) documentTitle = titleEl.textContent;

      // ツール自体がダークモード化しないよう、アバター画像用CSSクラスのみを抽出する
      const styleEls = doc.querySelectorAll('style');
      globalStyles = "";
      styleEls.forEach(style => {
        const text = style.innerHTML;
        const matches = text.match(/\.avatar-image-\d+\s*\{[^}]+\}/g);
        if (matches) {
          globalStyles += matches.join("\n") + "\n";
        }
      });
      
      let previewStyle = document.getElementById('preview-styles');
      previewStyle.innerHTML = globalStyles;

      const articles = doc.querySelectorAll('article.message');
      logs = [];
      activeTabs = new Set();
      tabNamesMap.clear();
      
      articles.forEach(article => {
        const isSystem = article.classList.contains('system');
        const tab = article.getAttribute('data-channel') || 'main';
        activeTabs.add(tab);
        
        let name = '', color = '#888888', timestamp = '', datetime = '', channelName = '', avatarClass = '';
        let content = '', rollResult = '', rollClass = '', edited = false;

        const channelEl = article.querySelector('.channel-name');
        if (channelEl) channelName = channelEl.textContent.trim();
        
        // 内部IDと表示名(日本語)の紐づけ
        if (channelName && !tabNamesMap.has(tab)) {
          tabNamesMap.set(tab, channelName);
        }

        const textEl = article.querySelector('.message-text');
        if (textEl) content = textEl.innerHTML.replace(/^\s+|\s+$/g, '');

        if (!isSystem) {
          const speakerEl = article.querySelector('.speaker');
          if (speakerEl) {
            name = speakerEl.textContent.trim();
            const styleColor = speakerEl.style.getPropertyValue('--speaker-color');
            if (styleColor) color = rgbToHex(styleColor);
          }
          
          const timeEl = article.querySelector('.timestamp');
          if (timeEl) {
            timestamp = timeEl.textContent.trim();
            datetime = timeEl.getAttribute('datetime') || '';
          }
          
          const avatarEl = article.querySelector('.avatar') || article.querySelector('.avatar-spacer');
          if (avatarEl) avatarClass = avatarEl.className;
          
          const rollEl = article.querySelector('.roll-result');
          if (rollEl) {
            rollResult = rollEl.innerHTML.replace(/^\s+|\s+$/g, '');
            rollClass = rollEl.className;
          }
          
          const editedEl = article.querySelector('.edited');
          if (editedEl) edited = true;
        }
        
        logs.push({ isSystem, tab, channelName, name, color, timestamp, datetime, avatarClass, content, rollResult, rollClass, edited, selected: false });
      });

      // 補完処理 (もしchannelNameが空だった場合の保険)
      activeTabs.forEach(t => {
        if (!tabNamesMap.has(t)) {
          tabNamesMap.set(t, `[${t}]`);
        }
      });

      if (logs.length > 0) {
        welcomeScreen.classList.add('hidden');
        sidebar.classList.remove('hidden');
        editorContainer.classList.remove('hidden');
        exportBtn.classList.remove('hidden');
        renderTabFilters();
        updateAddTabSelect();
        renderLogs();
      } else {
        alert('有効なココフォリアのHTMLログファイルが見つかりませんでした。');
      }
    }

    // 新規追加用のセレクトボックスを動的生成
    function updateAddTabSelect() {
      const addTab = document.getElementById('addTab');
      addTab.innerHTML = '';
      tabNamesMap.forEach((name, id) => {
        const option = document.createElement('option');
        option.value = id;
        option.textContent = name;
        addTab.appendChild(option);
      });
    }

    function renderTabFilters() {
      const tabSet = new Set();
      logs.forEach(log => tabSet.add(log.tab));
      tabFilters.innerHTML = '';
      tabSet.forEach(tab => {
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between text-sm bg-gray-50 p-2 rounded';
        
        const label = document.createElement('label');
        label.className = 'flex items-center space-x-2 cursor-pointer w-full';
        
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox'; checkbox.checked = activeTabs.has(tab);
        checkbox.className = 'rounded text-indigo-600 focus:ring-indigo-500 bg-white';
        checkbox.addEventListener('change', () => {
          checkbox.checked ? activeTabs.add(tab) : activeTabs.delete(tab);
          renderLogs();
        });
        
        const span = document.createElement('span');
        // 保存した日本語名を表示
        span.textContent = tabNamesMap.get(tab) || `[${tab}]`; 
        span.className = 'font-mono text-xs font-semibold';
        
        label.appendChild(checkbox); label.appendChild(span); div.appendChild(label);
        tabFilters.appendChild(div);
      });
    }

    function renderCharList() {
      const charsMap = new Map();
      logs.forEach(log => {
        if (!activeTabs.has(log.tab) || log.isSystem) return;
        if (!charsMap.has(log.name)) charsMap.set(log.name, log.color);
      });

      charList.innerHTML = '';
      if (charsMap.size === 0) {
        charList.innerHTML = '<p class="text-xs text-gray-400">表示中のキャラクターはいません</p>';
        return;
      }

      charsMap.forEach((color, name) => {
        const div = document.createElement('div');
        div.className = 'flex items-center justify-between bg-gray-50 p-2 rounded text-xs space-x-1';

        const nameInput = document.createElement('input');
        nameInput.type = 'text'; nameInput.value = name;
        nameInput.className = 'border border-gray-300 rounded px-1.5 py-0.5 w-28 text-xs focus:ring-1 focus:ring-indigo-500 bg-white text-gray-800';
        nameInput.addEventListener('change', () => {
          const newName = nameInput.value.trim();
          if (newName && newName !== name) {
            logs.forEach(log => {
              if (log.name === name) log.name = newName;
              if (log.content.includes(name)) log.content = log.content.split(name).join(newName);
              if (log.rollResult && log.rollResult.includes(name)) log.rollResult = log.rollResult.split(name).join(newName);
            });
            renderLogs();
          }
        });

        const colorIndicator = document.createElement('button');
        colorIndicator.className = 'w-5 h-5 rounded border border-black/20 shadow-sm transition transform hover:scale-110 shrink-0';
        colorIndicator.style.backgroundColor = color; colorIndicator.title = "カラーを一括変更";
        colorIndicator.onclick = () => openColorModal(name, color);

        div.appendChild(nameInput); div.appendChild(colorIndicator);
        charList.appendChild(div);
      });
    }

    function updateSelectionUI() {
      const count = logs.filter(log => log.selected).length;
      selectedCountLabel.textContent = `${count} 件`;
      deleteSelectedBtn.disabled = (count === 0);
    }

    selectAllBtn.onclick = () => { logs.forEach(log => { if (activeTabs.has(log.tab)) log.selected = true; }); renderLogs(); };
    deselectAllBtn.onclick = () => { logs.forEach(log => log.selected = false); renderLogs(); };
    deleteSelectedBtn.onclick = () => {
      if (fastDeleteMode || confirm('選択した発言を一括削除しますか？')) {
        logs = logs.filter(log => !log.selected);
        cancelInsertMode(); renderLogs();
      }
    };

    function openColorModal(name, currentColor) {
      activeColorTargetName = name;
      modalTargetChar.textContent = name;
      modalColorText.value = rgbToHex(currentColor);
      colorModal.classList.remove('hidden');
    }
    modalCancelBtn.onclick = () => colorModal.classList.add('hidden');
    modalConfirmBtn.onclick = () => {
      let targetColor = modalColorText.value.trim();
      if (!targetColor.startsWith('#')) targetColor = '#' + targetColor;
      if (/^#[0-9A-F]{6}$/i.test(targetColor) || /^#[0-9A-F]{3}$/i.test(targetColor)) {
        logs.forEach(log => { if (log.name === activeColorTargetName) log.color = targetColor.toLowerCase(); });
        colorModal.classList.add('hidden'); renderLogs();
      } else alert('正しいカラーコードを入力してください。');
    };

    function renderLogs() {
      currentEditIndex = null;
      logList.innerHTML = '';

      logs.forEach((log, index) => {
        if (!activeTabs.has(log.tab)) return;

        const p = document.createElement('div');
        let bgStyle = 'bg-white border-gray-200 hover:border-indigo-300';
        if (log.selected) bgStyle = 'bg-amber-50/80 border-amber-300 ring-1 ring-amber-200';
        else if (insertTargetIndex === index) bgStyle = 'border-blue-500 ring-2 ring-blue-100 bg-blue-50/10';

        p.className = `flex items-start border rounded p-2.5 shadow-sm space-x-2 relative group transition duration-150 ${bgStyle}`;
        p.dataset.index = index;

        const selectCb = document.createElement('input');
        selectCb.type = 'checkbox'; selectCb.checked = !!log.selected;
        selectCb.className = 'rounded text-amber-600 focus:ring-amber-500 cursor-pointer mt-1 shrink-0 bg-white';
        selectCb.onchange = (e) => { log.selected = e.target.checked; updateSelectionUI(); renderLogs(); };

        const handle = document.createElement('div');
        handle.className = 'drag-handle text-gray-400 p-1 hover:text-gray-600 transition shrink-0';
        handle.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 8h16M4 16h16"></path></svg>`;

        const tabBadge = document.createElement('span');
        tabBadge.className = 'font-mono text-xs font-bold px-2 py-0.5 rounded bg-white text-gray-600 border shrink-0 mt-0.5';
        // ここも日本語の表示名を出力
        tabBadge.textContent = log.channelName || tabNamesMap.get(log.tab) || `[${log.tab}]`;

        const contentBox = document.createElement('div');
        contentBox.className = 'flex-1 space-y-1 min-w-0';

        if (!log.isSystem) {
          const header = document.createElement('div');
          header.className = 'flex items-center space-x-2';
          
          const avatarIcon = document.createElement('div');
          avatarIcon.className = (log.avatarClass || 'avatar-spacer') + ' w-6 h-6 bg-contain bg-no-repeat bg-center shrink-0 border border-gray-200 rounded';
          
          const nameSpan = document.createElement('span');
          nameSpan.className = 'font-bold text-sm'; nameSpan.style.color = log.color; nameSpan.textContent = log.name;

          const timeSpan = document.createElement('span');
          timeSpan.className = 'text-xs text-gray-400'; timeSpan.textContent = log.timestamp;

          header.appendChild(avatarIcon); header.appendChild(nameSpan); header.appendChild(timeSpan);
          if (log.edited) {
            const editSpan = document.createElement('span');
            editSpan.className = 'text-[10px] text-gray-400 border border-gray-300 px-1 rounded'; editSpan.textContent = '編集済';
            header.appendChild(editSpan);
          }
          contentBox.appendChild(header);
        }

        const bodyText = document.createElement('div');
        bodyText.className = log.isSystem ? 'text-sm text-gray-500 italic whitespace-pre-wrap leading-relaxed break-all' : 'text-sm text-gray-800 whitespace-pre-wrap leading-relaxed break-all';
        bodyText.innerHTML = log.content;
        contentBox.appendChild(bodyText);

        if (log.rollResult) {
          const rollText = document.createElement('div');
          rollText.className = 'text-xs mt-1 font-mono p-1 bg-gray-50 border rounded';
          if (log.rollClass.includes('success') || log.rollClass.includes('critical')) rollText.classList.add('text-blue-600');
          else if (log.rollClass.includes('failure') || log.rollClass.includes('fumble')) rollText.classList.add('text-red-600');
          else rollText.classList.add('text-gray-500');
          rollText.innerHTML = log.rollResult;
          contentBox.appendChild(rollText);
        }

        const ctrl = document.createElement('div');
        ctrl.className = 'flex items-center space-x-1 shrink-0 self-center opacity-0 group-hover:opacity-100 transition duration-150';

        const insBtn = document.createElement('button');
        insBtn.className = 'p-1 hover:bg-blue-50 rounded text-blue-600 transition'; insBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>`;
        insBtn.onclick = () => setInsertTarget(index, log.isSystem ? 'システム' : log.name);

        const edBtn = document.createElement('button');
        edBtn.className = 'p-1 hover:bg-gray-100 rounded text-indigo-600 transition'; edBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>`;
        edBtn.onclick = () => enterEditMode(index, log, contentBox);

        const delBtn = document.createElement('button');
        delBtn.className = fastDeleteMode ? 'p-1 bg-red-100 hover:bg-red-200 rounded text-red-600 font-bold transition' : 'p-1 hover:bg-red-50 rounded text-red-500 transition';
        delBtn.innerHTML = `<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>`;
        delBtn.onclick = () => { if (fastDeleteMode || confirm('削除しますか？')) { logs.splice(index, 1); cancelInsertMode(); renderLogs(); } };

        ctrl.appendChild(insBtn); ctrl.appendChild(edBtn); ctrl.appendChild(delBtn);
        p.appendChild(selectCb); p.appendChild(handle); p.appendChild(tabBadge); p.appendChild(contentBox); p.appendChild(ctrl);
        logList.appendChild(p);
      });
      updateSelectionUI(); renderCharList();
    }

    function setInsertTarget(index, charName) {
      insertTargetIndex = index;
      insertTargetLabel.textContent = `No.${index + 1} [${charName}]`;
      insertIndicator.classList.remove('hidden');
      addLogBtn.textContent = '指定位置に挿入'; addLogBtn.className = 'w-full bg-blue-600 hover:bg-blue-500 text-white text-xs py-2 rounded font-semibold transition';
      renderLogs(); document.getElementById('addName').focus();
    }
    function cancelInsertMode() {
      insertTargetIndex = null; insertIndicator.classList.add('hidden');
      addLogBtn.textContent = '末尾に追加'; addLogBtn.className = 'w-full bg-indigo-600 hover:bg-indigo-500 text-white text-xs py-2 rounded font-semibold transition';
    }
    cancelInsertBtn.onclick = () => { cancelInsertMode(); renderLogs(); };

    function enterEditMode(index, log, contentBox) {
      if (currentEditIndex !== null) return; currentEditIndex = index;

      const editContainer = document.createElement('div');
      editContainer.className = 'space-y-2 mt-1 w-full';

      const txaContent = document.createElement('textarea');
      txaContent.className = 'w-full border border-gray-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-indigo-500 bg-white text-gray-800'; txaContent.rows = 3;
      txaContent.value = log.content.replace(/<br\s*\/?>/gi, '\n');
      editContainer.appendChild(txaContent);

      let txaRoll = null;
      if (log.rollResult || log.rollClass) {
        txaRoll = document.createElement('textarea');
        txaRoll.className = 'w-full border border-blue-300 rounded px-2 py-1.5 text-sm focus:ring-1 focus:ring-blue-500 bg-blue-50 text-gray-800'; txaRoll.rows = 2;
        txaRoll.value = log.rollResult.replace(/<br\s*\/?>/gi, '\n');
        editContainer.appendChild(txaRoll);
      }

      const actionDiv = document.createElement('div');
      actionDiv.className = 'flex space-x-2 justify-end';

      const cancelBtn = document.createElement('button'); cancelBtn.className = 'px-3 py-1 text-xs bg-gray-200 hover:bg-gray-300 rounded text-gray-700 transition'; cancelBtn.textContent = 'キャンセル';
      cancelBtn.onclick = () => { currentEditIndex = null; renderLogs(); };

      const saveBtn = document.createElement('button'); saveBtn.className = 'px-3 py-1 text-xs bg-indigo-600 hover:bg-indigo-500 text-white rounded font-semibold transition'; saveBtn.textContent = '保存';
      saveBtn.onclick = () => {
        log.content = txaContent.value.replace(/\n/g, '<br>');
        if (txaRoll) log.rollResult = txaRoll.value.replace(/\n/g, '<br>');
        currentEditIndex = null; renderLogs();
      };

      actionDiv.appendChild(cancelBtn); actionDiv.appendChild(saveBtn); editContainer.appendChild(actionDiv);
      
      Array.from(contentBox.children).forEach(child => { if (!child.classList.contains('flex')) child.remove(); });
      contentBox.appendChild(editContainer);
    }

    addLogBtn.onclick = () => {
      const name = document.getElementById('addName').value.trim();
      const tab = document.getElementById('addTab').value; // タブのID(内部ID)を取得
      let color = addTextColor.value.trim();
      const content = document.getElementById('addContent').value.replace(/\n/g, '<br>');

      if (!content) { alert('発言内容を入力してください。'); return; }

      // 名前が空欄なら自動的にシステムメッセージ扱いにする
      const isSystem = (name === '');
      // セレクトボックスで選んだIDから日本語名を取得
      const channelName = tabNamesMap.get(tab) || `[${tab}]`;

      if (!color.startsWith('#')) color = '#' + color;
      if (!/^#[0-9A-F]{6}$/i.test(color) && !/^#[0-9A-F]{3}$/i.test(color)) color = '#888888'; 

      const newLog = {
        isSystem: isSystem, 
        tab: tab, 
        channelName: channelName,
        name: name, 
        color: color.toLowerCase(), 
        timestamp: new Date().toLocaleTimeString('ja-JP', { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
        datetime: new Date().toISOString(), 
        avatarClass: 'avatar-spacer', 
        content: content, 
        rollResult: '', 
        rollClass: '', 
        edited: false, 
        selected: false
      };

      if (insertTargetIndex !== null) {
        logs.splice(insertTargetIndex + 1, 0, newLog);
        cancelInsertMode(); setInsertTarget(insertTargetIndex + 1, newLog.isSystem ? 'システム' : name);
      } else {
        logs.push(newLog); renderLogs(); editorContainer.scrollTop = editorContainer.scrollHeight;
      }
      document.getElementById('addContent').value = '';
    };

    removeSlashBtn.onclick = () => {
      if (confirm('文末や括弧直後の「/」を一括削除します。よろしいですか？')) {
        let c = 0;
        logs.forEach(log => {
          ['content', 'rollResult'].forEach(k => {
            if (log[k]) {
              const orig = log[k];
              log[k] = log[k].replace(/([」』])[/／]/g, '$1').replace(/[/／](\s*(?:<br\s*\/?>\s*)*)$/i, '$1');
              if (orig !== log[k]) c++;
            }
          });
        });
        renderLogs(); alert(`${c}箇所の「/」を削除しました。`);
      }
    };

    executeReplaceBtn.onclick = () => {
      const s = replaceSearchInput.value, r = replaceWithInput.value;
      if (!s) return alert('検索する文字列を入力してください。');
      if (confirm(`「${s}」を一括で${r ? '「'+r+'」に置換' : '削除'}します。よろしいですか？`)) {
        let c = 0;
        logs.forEach(log => {
          ['content', 'rollResult'].forEach(k => {
            if (log[k] && log[k].includes(s)) { log[k] = log[k].split(s).join(r); c++; }
          });
        });
        renderLogs(); alert(`${c}箇所を処理しました。`);
      }
    };

    executeFilterDeleteBtn.onclick = () => {
      const dK = filterDeleteInput.value.trim(), pK = filterProtectInput.value.trim();
      if (!dK) return alert('削除対象にする文字列を入力してください。');
      if (fastDeleteMode || confirm(`「${dK}」を含む発言を一括削除します。${pK ? '（「'+pK+'」を含むものは保護）' : ''}`)) {
        const b = logs.length;
        logs = logs.filter(log => {
          const combined = log.content + (log.rollResult || '');
          return !combined.includes(dK) || (pK && combined.includes(pK));
        });
        cancelInsertMode(); renderLogs(); alert(`${b - logs.length}件を削除しました。`);
      }
    };

    simplifyDiceBtn.onclick = () => {
      if (confirm('ダイス判定ロールを簡略化しますか？')) {
        let count = 0;
        logs.forEach(log => {
          if (!log.rollResult) return;
          const lePattern = '(?:<=|&lt;=|＜＝|≦)';
          const cmdRegex = new RegExp(`^\\s*(s?(?:ccb|cc|cbrb|resb|1d100))\\s*(?:${lePattern}\\s*([^\\s<【（(「\\[［]+)|[（(]([^)）]+)[)）])?`, 'i');
          const rollRegex = new RegExp(`[\\(（]1[dD]100\\s*${lePattern}\\s*([^()（）]+)[\\)）]\\s*[＞>]\\s*(.+)$`, 's');

          const cmdMatch = log.content.match(cmdRegex);
          const rollMatch = log.rollResult.match(rollRegex);
          if (cmdMatch && rollMatch) {
            let cmdType = cmdMatch[1].toLowerCase();
            if (cmdType.startsWith('s')) cmdType = cmdType.slice(1);
            let targetVal = (cmdType === 'cbrb' && (cmdMatch[2] || cmdMatch[3])) ? (cmdMatch[2] || cmdMatch[3]).trim() : rollMatch[1].trim(); 
            let rawComment = log.content.substring(cmdMatch[0].length).replace(/<br\s*\/?>/gi, ' ').replace(/\s+/g, ' ').trim().replace(/(【.*?】)\s+([＞>])/g, '$1$2');
            let comment = rawComment ? (/【.*?】/.test(rawComment) ? rawComment : (/[（(「\[［≪『〈《{｛〔](.*?)[)）\]］≫』〉》}｝〕]/g.test(rawComment) ? rawComment.replace(/[（(「\[［≪『〈《{｛〔](.*?)[)）\]］≫』〉》}｝〕]/g, '【$1】') : `【${rawComment}】`)) : (cmdType === 'cbrb' ? '【複合ロール】' : cmdType === 'resb' ? '【対抗】' : '【成功値】');
            log.rollResult = `${targetVal}${comment} ${rollMatch[2].trim()}`;
            log.content = ''; count++;
          }
        });
        renderLogs(); alert(`${count}件のダイスロールを簡略化しました。`);
      }
    };

    exportBtn.onclick = () => {
      let bodyContent = '';
      logs.forEach(log => {
        if (!activeTabs.has(log.tab)) return;
        if (log.isSystem) {
          bodyContent += `\n      <article class="message system" data-channel="${escapeHTML(log.tab)}">\n        <div class="message-header">\n          <span class="channel-name">${escapeHTML(log.channelName || '[' + log.tab + ']')}</span>\n        </div>\n        <div class="message-text">${log.content}</div>\n      </article>\n`;
        } else {
          let rollHtml = log.rollResult ? `\n          <span class="${escapeHTML(log.rollClass)}">${log.rollResult}</span>` : '';
          let editedHtml = log.edited ? `\n            <span class="edited">[編集済]</span>` : '';
          let avatarHtml = `\n        <span class="${escapeHTML(log.avatarClass || 'avatar-spacer')}" aria-hidden="true"></span>`;
          bodyContent += `\n      <article class="message" data-channel="${escapeHTML(log.tab)}">${avatarHtml}\n        <div class="message-content">\n          <div class="message-header">\n            <span class="speaker" style="--speaker-color:${log.color}">${escapeHTML(log.name)}</span>\n            <time class="timestamp" datetime="${escapeHTML(log.datetime)}">${escapeHTML(log.timestamp)}</time>\n            <span class="channel-name">${escapeHTML(log.channelName || '[' + log.tab + ']')}</span>${editedHtml}\n          </div>\n          <div class="message-text">${log.content}</div>${rollHtml}\n        </div>\n      </article>\n`;
        }
      });

      const finalHTML = `<!DOCTYPE html>\n<html lang="ja">\n  <head>\n    <meta charset="UTF-8" />\n    <meta name="viewport" content="width=device-width, initial-scale=1.0" />\n    <title>${escapeHTML(documentTitle)}</title>\n    <style>\n      :root { color-scheme: dark; color: #eee; background: #121212; }\n      * { box-sizing: border-box; }\n      body { min-width: 280px; margin: 0; background: #121212; }\n      .message-list { width: 100%; max-width: 960px; margin: 0 auto; padding: 0 24px 48px; }\n      .log-title { margin: 24px 0; font-size: 24px; }\n      .message { display: grid; grid-template-columns: 40px minmax(0, 1fr); column-gap: 12px; padding: 16px 0; border-bottom: 1px solid #262626; }\n      .message.system { display: block; padding-left: 52px; color: #888; }\n      .avatar, .avatar-spacer { width: 40px; height: 40px; }\n      .avatar { display: block; background-repeat: no-repeat; background-size: 100% 100%; }\n      .message-content { min-width: 0; }\n      .message-header { display: flex; align-items: baseline; flex-wrap: wrap; gap: 8px; }\n      .speaker { color: var(--speaker-color); font-size: 14px; font-weight: bold; }\n      .timestamp, .edited, .channel-name { color: #888; font-size: 12px; }\n      .message-text, .roll-result { font-size: 16px; line-height: 1.6; overflow-wrap: anywhere; white-space: pre-wrap; }\n      .roll-result { display: block; color: #888; }\n      .roll-result.success, .roll-result.critical { color: #2196f3; }\n      .roll-result.failure, .roll-result.fumble { color: #dc004e; }\n${globalStyles}\n    </style>\n  </head>\n  <body>\n    <main class="message-list">\n      <h1 class="log-title">${escapeHTML(documentTitle)}</h1>\n${bodyContent}    </main>\n  </body>\n</html>`;

      const blob = new Blob([finalHTML], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url;
      a.download = loadedFileName ? loadedFileName.replace(/\.[^/.]+$/, "_整形.html") : 'edited_ccfolia_log.html';
      document.body.appendChild(a); a.click(); document.body.removeChild(a); URL.revokeObjectURL(url);
    };

    function escapeHTML(string) {
      return string.replace(/[&<>"']/g, match => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[match]));
    }
  </script>
</body>
</html>
